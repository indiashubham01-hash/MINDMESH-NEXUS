{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/voice-request",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/resources/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/plans/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/learners/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/class/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/quizzes/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/gnn/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ml/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/download-env",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/download-env-example",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
